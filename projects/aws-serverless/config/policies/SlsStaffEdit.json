{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteDocTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-northeast-2:*:table/sls-*-docs"
    }
  ]
}
